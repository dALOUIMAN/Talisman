# NoxCore Agent Zero Configuration
# AI-focused distributed agent system

# Agent Settings
AGENT_MODE=local
AGENT_HIVE=enabled
COORDINATOR_ENABLED=true

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Logging
LOG_LEVEL=INFO

# Performance Settings
MAX_AGENTS=10
TASK_TIMEOUT=300
HEARTBEAT_INTERVAL=60
AGENT_TTL=300

# Resource Limits (for ultra-lightweight operation)
MAX_MEMORY_MB=256
MAX_CPU_PERCENT=50
REDIS_MAXMEMORY=256mb
